{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",

    "patternProperties": {
        "^[a-z-]*$": {
            "$ref": "#/definitions/font"
        }
    },

    "definitions": {
        "font": {
            "type": "object",
            "properties": {
                "added": {
                    "oneOf": [
                        { "type": "string", "enum": ["bc"] },
                        { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
                    ]
                },
                "author": { "type": "string" },
                "bitmap size": {
                    "type": "number"
                },
                "bitmap height": {
                    "type": "number"
                },
                "characters": { "type": "integer" },
                "description": { "type": "string" },
                "glyphs": { "type": "integer" },
                "group": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]+$"
                },
                "huge": { "type": "boolean" },
                "languages": {
                    "type": "object",
                    "patternProperties": {
                        "^[a-zA-Z]+$": { "type": "integer" }
                    }
                },
                "license": {
                    "type": "string",
                    "enum": [
                        "commercial",
                        "Apache",
                        "Bitstream Vera",
                        "BSD-2-Clause",
                        "CC BY-SA 3.0",
                        "CC BY-SA 4.0",
                        "CC BY-ND 3.0",
                        "freeware",
                        "GNU GPL",
                        "GUST font license",
                        "Luxi License",
                        "MIT",
                        "none",
                        "permissive",
                        "public domain",
                        "SIL OFL",
                        "Ubuntu Font Licence",
                        "WTFPL"
                    ]
                },
                "ligatures": { "type": "boolean" },
                "name": { "type": "string" },
                "rendering": {
                    "type": "string",
                    "enum": ["bitmap", "vector"]
                },
                "style": {
                    "type": "string",
                    "enum": ["serif", "sans"]
                },
                "variants": {
                    "oneOf": [
                        {
                            "type": "array",
                            "items": {
                                "type": "string",
                                "pattern": "^([a-z-]+|\\d00)$"
                            },
                            "minItems": 1
                        },
                        {
                            "type": "string"
                        }
                    ]
                },
                "website": {
                    "type": "string",
                    "format": "uri"
                },
                "year": { "type": "integer" },
                "zerostyle": {
                    "type": "string",
                    "enum": ["empty", "slashed", "dotted"]
                }
            },
            "additionalProperties": false,
            "required": [
                "added",
                "author",
                "description",
                "glyphs",
                "license",
                "ligatures",
                "name",
                "rendering",
                "style",
                "variants",
                "website",
                "year"
            ]
        }
    }
}
